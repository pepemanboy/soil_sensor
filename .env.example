TUYA_BASE_URL=https://openapi.tuyaus.com
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# Pick ONE way to locate devices:
# TUYA_SCHEMA=your_smart_home_app_schema_id
# TUYA_HOME_ID=1234567890
# TUYA_UID=ay1234567890xxxx
# TUYA_DEVICE_IDS=device_id_1,device_id_2   # works alone if copied from the console

# Optional filters (combine with UID / HOME_ID / SCHEMA):
# TUYA_DEVICE_CATEGORY=zwjcy                  # plant monitor / soil sensor
# TUYA_DEVICE_CATEGORIES=zwjcy,other
# TUYA_PRODUCT_IDS=npj9bug3
# TUYA_DEVICE_IDS=id1,id2

# Runtime data directory (config, history, alert state); default ./data
# DATA_DIR=./data

# History storage (local SQLite file by default; Postgres in cloud via DATABASE_URL)
# HISTORY_DB_PATH=./data/history.db
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_SSL=false
# POLL_INTERVAL_MS=300000
# HISTORY_POLL=false
# POLL_ON_START=false
# HISTORY_CODES=humidity,temp_current,battery_percentage

PORT=3000
# HOST=127.0.0.1
# TRUST_PROXY=true

# Alert config is stored in ./data/config.json (device IDs, not names)

# Required — protects the dashboard, APIs, and alert config
CONFIG_PASSWORD=choose-a-strong-password

# Daily email alert (once per day at ALERT_HOUR_LOCAL, default 8:00)
# ALERT_EMAIL_ENABLED=false
# ALERT_HOUR_LOCAL=8
# ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_CC=partner@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=you@gmail.com
