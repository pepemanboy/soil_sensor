TUYA_BASE_URL=https://openapi.tuyaus.com
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# Pick ONE way to locate devices:
# TUYA_SCHEMA=your_smart_home_app_schema_id
# TUYA_HOME_ID=1234567890
# TUYA_UID=ay1234567890xxxx
# TUYA_DEVICE_IDS=device_id_1,device_id_2   # works alone if copied from the console

# Optional filters (combine with UID / HOME_ID / SCHEMA):
# TUYA_DEVICE_CATEGORY=zwjcy                  # plant monitor / soil sensor
# TUYA_DEVICE_CATEGORIES=zwjcy,other
# TUYA_PRODUCT_IDS=npj9bug3
# TUYA_DEVICE_IDS=id1,id2

# Neon (required for Vercel; recommended for local npm start)
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=false   # only if your provider does not need SSL

# Optional: omit DATABASE_URL to use ./data/history.db + ./data/config.json locally

# History poller (npm start only; production uses cron-job.org → /api/cron/poll)
# POLL_INTERVAL_MS=300000
# HISTORY_POLL=false
# POLL_ON_START=false
# HISTORY_CODES=humidity,temp_current,battery_percentage

PORT=3000
# HOST=127.0.0.1
# TRUST_PROXY=true

# Required — protects the dashboard and APIs
CONFIG_PASSWORD=choose-a-strong-password

# Vercel Cron auth (generate a long random string)
# CRON_SECRET=
